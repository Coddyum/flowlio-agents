# Copier en .env et remplir. Lu par config.Load() ET par le Makefile.
# La valeur ci-dessous correspond au Postgres 18 de docker-compose.yml (port 5433).
DATABASE_URL=postgres://flowlio:flowlio@localhost:5433/flowlio?sslmode=disable
ADDR=:8080
ENV=dev
MODE=local

# --- Production (Neon, Postgres 18) ---
# Jamais renseigné dans ce fichier, jamais commité. TLS obligatoire : sslmode=require.
#
# Endpoint DIRECT (migrations, `make up-prod`) :
#   DATABASE_URL_PROD=postgres://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/flowlio?sslmode=require
#
# Endpoint MUTUALISÉ (l'API, hôte en «-pooler») : PgBouncer en mode transaction ne survit pas au
# cache de requêtes préparées de pgx — ajouter default_query_exec_mode=exec, sinon le démarrage
# est refusé volontairement.
#   DATABASE_URL=postgres://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/flowlio?sslmode=require&default_query_exec_mode=exec
